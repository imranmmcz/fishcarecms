# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://fishcare.lovable.app

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=fishcare
DB_CONNECTION_LIMIT=10
DB_SSL=false
# If your provider requires SSL (PlanetScale, Aiven, etc.) set DB_SSL=true
# and optionally provide a base64-encoded CA cert:
# DB_SSL_CA_BASE64=

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex
JWT_EXPIRES_IN=7d

# ---- Rate limit ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200