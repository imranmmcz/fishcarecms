# =====================================================
# Frontend production environment for Hostinger build
# Copy to `.env.production` before running `npm run build`.
# =====================================================

# MySQL backend API base URL (Express server running on Hostinger)
# Should resolve to /api after the .htaccess proxy.
VITE_API_URL=https://fishcare.com.bd/api

# Keep these in sync with your Lovable Cloud / Supabase project
# (auto-managed in dev; copy values from .env when building manually)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=