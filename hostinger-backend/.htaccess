# Enable Rewrite Engine
RewriteEngine On

# CORS Configuration - Dynamic Origin Support
# Allows: fishcal.lovable.app, *.lovableproject.com, blog.fishcare.com.bd, localhost
<IfModule mod_headers.c>
    # Match Lovable domains dynamically
    SetEnvIf Origin "^https://([a-z0-9-]+\.)?lovableproject\.com$" ORIGIN_OK=$0
    SetEnvIf Origin "^https://([a-z0-9-]+\.)?lovable\.app$" ORIGIN_OK=$0
    SetEnvIf Origin "^https://fishcal\.lovable\.app$" ORIGIN_OK=$0
    SetEnvIf Origin "^https://blog\.fishcare\.com\.bd$" ORIGIN_OK=$0
    SetEnvIf Origin "^http://localhost:(5173|8080|3000)$" ORIGIN_OK=$0
    
    # Set CORS headers when origin matches
    Header always set Access-Control-Allow-Origin "%{ORIGIN_OK}e" env=ORIGIN_OK
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

# Handle OPTIONS preflight requests immediately
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Proxy all /api requests to Node.js server (port 3001)
RewriteCond %{REQUEST_URI} ^/api(.*)$
RewriteRule ^api(.*)$ http://127.0.0.1:3001/api$1 [P,L]

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
