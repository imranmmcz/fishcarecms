# =====================================================
# FishCare Pro - Hostinger Backend Environment Variables
# এই ফাইলটি কপি করে .env নামে সেভ করুন এবং আপনার তথ্য দিয়ে পূরণ করুন
# =====================================================

# ========== Database Configuration (Hostinger MySQL) ==========
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u_your_database_name
DB_USER=u_your_database_user
DB_PASSWORD=your_secure_password

# ========== JWT Configuration ==========
# গুরুত্বপূর্ণ: প্রোডাকশনে একটি শক্তিশালী র‍্যান্ডম স্ট্রিং ব্যবহার করুন
# জেনারেট করুন: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-very-long-random-string
JWT_EXPIRES_IN=7d

# ========== Server Configuration ==========
PORT=3001
NODE_ENV=production

# ========== Database Auto-Init ==========
# true  → backend connects to MySQL, runs CREATE DATABASE IF NOT EXISTS,
#         and applies every *.sql file in database/ on every boot
#         (safe — uses IF NOT EXISTS / INSERT IGNORE).
# false → skip auto bootstrap (use this only if you manage schema manually).
AUTO_INIT_DB=true

# ========== Frontend URL (CORS) ==========
# আপনার ফ্রন্টএন্ড ডোমেইন (কমা দিয়ে একাধিক)
FRONTEND_URL=https://your-domain.com

# ========== File Upload ==========
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ========== Optional: Google Drive Backup ==========
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
