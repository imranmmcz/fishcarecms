# =====================================================
# LOCAL .env  — DO NOT COMMIT REAL CREDENTIALS
# Copy this file, then fill with your real Hostinger MySQL values.
# On the server, place the real .env OUTSIDE git, in the app root.
# =====================================================

# Database Configuration (Hostinger MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uXXXXXXXXX_dbname
DB_USER=uXXXXXXXXX_dbuser
DB_PASSWORD=replace_with_strong_password

# JWT Configuration — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex
JWT_EXPIRES_IN=7d

# Server Configuration  (must match .htaccess proxy + ecosystem.config.js)
PORT=3001
NODE_ENV=production
AUTO_INIT_DB=true

# Frontend URL (for CORS)
FRONTEND_URL=https://fishcare.com.bd

# Additional allowed origins (comma-separated)
ALLOWED_ORIGINS=https://fishcal.lovable.app,https://fishcare.lovable.app,https://fishcare.com.bd,https://www.fishcare.com.bd

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
